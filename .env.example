# ---------------------------------------------------------------------------
# Complex Mathematics Tutor Agent - example environment file
#
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# NEVER commit a real .env file. No API key is hard-coded anywhere in the code.
# ---------------------------------------------------------------------------

# Which backend to use: auto | openai | openai_compatible | ollama | deterministic
#   auto            -> use a real model when an API key is set, else the offline engine
#   deterministic   -> force the offline engine (works with no key, no network)
MATH_TUTOR_PROVIDER=auto

# Chat model name.
MATH_TUTOR_MODEL=gpt-4o-mini

# Vision model used for the `image` command. Falls back to MATH_TUTOR_MODEL.
# MATH_TUTOR_VISION_MODEL=gpt-4o-mini

# --- OpenAI (or any OpenAI-compatible gateway) -----------------------------
# Leave empty to run fully offline with the deterministic provider.
OPENAI_API_KEY=
# Only set this for a self-hosted / third-party OpenAI-compatible endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=http://localhost:11434/v1   # example: local Ollama

# --- Sampling -----------------------------------------------------------------
MATH_TUTOR_TEMPERATURE=0.2
MATH_TUTOR_MAX_TOKENS=1200
MATH_TUTOR_TIMEOUT=60

# --- Graph limits (protect against clarification / repair loops) -------------
MATH_TUTOR_MAX_CLARIFICATIONS=3
MATH_TUTOR_MAX_SOLVE_ATTEMPTS=2

# --- Verification ------------------------------------------------------------
# Run the extra model based answer review on top of the deterministic check.
MATH_TUTOR_MODEL_REVIEW=true

# --- Images ------------------------------------------------------------------
# Folder where the CLI looks for images when a relative path is given.
MATH_TUTOR_IMAGES_DIR=images
